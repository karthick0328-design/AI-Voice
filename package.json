{
  "name": "ai-personal-agent",
  "version": "1.0.0",
  "description": "Advanced Local Personal AI Agent and AI OS with 3D Avatar, Ollama, RAG, Memory, and Automation",
  "main": "server/src/index.js",
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"cyan,magenta\" \"npm run server\" \"npm run client\"",
    "server": "npm --prefix server run dev",
    "client": "npm --prefix client start",
    "build": "npm --prefix client run build",
    "start": "npm --prefix server start",
    "install:all": "npm install && npm --prefix server install && npm --prefix client install"
  },
  "keywords": [
    "ai",
    "agent",
    "ollama",
    "personal-assistant",
    "threejs",
    "rag",
    "local-ai"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
